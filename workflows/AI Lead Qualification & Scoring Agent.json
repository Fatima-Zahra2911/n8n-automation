    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let score = 0;\n\n// Budget points\nif ($json.Budget == \"$1000+\") score += 4;\nelse if ($json.Budget == \"$500–$1000\") score += 3;\nelse if ($json.Budget == \"$100–$500\") score += 2;\nelse score += 1;\n\n// Timeline points\nif ($json.Timeline == \"Urgent\") score += 3;\nelse if ($json.Timeline == \"Within a week\") score += 2;\nelse score += 1;\n\n// Service points\nif ($json.Service == \"Website Development\") score += 3;\nelse if ($json.Service == \"SEO\") score += 2;\nelse score += 1;\n\n// Keywords in message\nconst message = $json.Message.toLowerCase();\nif (message.includes(\"asap\") || message.includes(\"immediately\")) score += 2;\n\nlet leadCategory = \"\";\nif (score >= 8) leadCategory = \"Hot\";\nelse if (score >= 5) leadCategory = \"Warm\";\nelse leadCategory = \"Cold\";\n\nreturn {\n  json: {\n    ...$json,\n    Score: leadCategory,\n    TotalPoints: score\n  }\n};"
      },
