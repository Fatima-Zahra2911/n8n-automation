    {
      "parameters": {
        "jsCode": "let products = {};\nfor (let item of items) {\n  let name = item.json[\"Product Name\"];\n  if (!products[name]) products[name] = [];\n  products[name].push(item.json[\"Review Text\"]);\n}\n\nreturn Object.keys(products).map(name => ({\n  json: {\n    product_name: name,\n    review_text_array: products[name]\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "6681a2ff-054c-47f9-a885-759cb7804c8e",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze the following reviews for the product \"{{ $json[\"product_name\"] }}\" and return JSON as specified in the system message.\n\nReviews:\n{{ $json[\"review_text_array\"] }}",
        "options": {
          "systemMessage": "You are an expert e-commerce product analyst. \nYour task is to analyze product reviews and provide actionable insights. \nYou must always return a **structured JSON object** containing:\n\n1. sentiment – Overall sentiment of reviews: Positive / Negative / Mixed\n2. top_complaints – List of top 5 most common complaints from customers\n3. top_praises – List of top 5 features or points customers praise\n4. product_improvements – List of actionable suggestions to improve the product\n\nFocus only on the information in the provided reviews. \nDo not add unrelated opinions."
        }
      },
