    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => {\n  const name = item.json.name;\n  const lastProduct = item.json.last_product;\n  const status = item.json.Status;\n  const discount = status === \"VIP\" ? \"15%\" : \"10%\";\n\n  item.json.email_subject = \"We Miss You at Our Store!\";\n  item.json.email_body = `\n  <div style=\"font-family: Arial, sans-serif; color: #333; line-height: 1.5; max-width: 600px; margin: auto; padding: 20px; background-color: #fdfdfd; border-radius: 10px; border: 1px solid #eee;\">\n    <h2 style=\"color: #e91e63; text-align: center;\">We Miss You, ${name}!</h2>\n    <p>It's been a while since your last visit. You loved <strong>${lastProduct}</strong> last time – and we thought you might like something new!</p>\n    <p><strong>As our ${status} customer</strong>, we're excited to offer you an exclusive <strong style=\"color: #e91e63;\">${discount} discount</strong> on your next order.</p>\n    <p>Don’t miss out! Your favorites are waiting for you.</p>\n    <div style=\"text-align: center; margin: 30px 0;\">\n      <a href=\"https://fatimajewelryfinds.blogspot.com/\" style=\"background-color: #e91e63; color: white; padding: 10px 20px; border-radius: 5px; text-decoration: none; font-weight: bold;\">Shop Now</a>\n    </div>\n  </div>\n  `;\n\n  return item;\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
