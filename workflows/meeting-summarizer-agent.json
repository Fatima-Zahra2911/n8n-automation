      "parameters": {
        "promptType": "define",
        "text": "=Transcript:\n{{ $json[\"Transcript\"] }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=You are an AI meeting assistant.\n\nAnalyze the following meeting transcript and return ONLY valid JSON.\n\nExtract:\n\n1. summary: a short paragraph summarizing the meeting.\n2. decisions: an array of key decisions made.\n3. action_items: an array of objects, each containing:\n   - task: description of the task\n   - assignee: who will do it (if not mentioned, write \"Unassigned\")\n   - deadline: date or \"None\" if not mentioned\n   - priority: High, Medium, or Low\n   - status: always \"To Do\"\n- Summary: text summry of meeting 2-3 lines\"\n- source: name of link source\n"
        }
      },
