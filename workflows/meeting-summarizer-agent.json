    {
      "parameters": {
        "jsCode": "// Parse AI output string to JSON and prepare for further workflow\nlet data = $input.first().json.output; // AI node output\nif (typeof data === \"string\") {\n  data = JSON.parse(data);\n}\n\n// Map action_items into separate objects with all fields, including source & summary\nlet items = data.action_items.map(item => {\n  return {\n    json: {\n      task: item.task,\n      assignee: item.assignee,\n      deadline: item.deadline,\n      priority: item.priority,\n      status: item.status,\n      summary: data.summary,   // include meeting summary\n      source: data.source   \n      // include source (e.g., Transcript)\n    }\n  };\n});\n\nreturn items;"
      },
