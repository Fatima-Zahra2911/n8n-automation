        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Tasks Added to Notion</title>\n  <style>\n    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }\n    h2 { color: #4CAF50; }\n    a { color: #1a73e8; text-decoration: none; }\n    .info { margin-top: 10px; margin-bottom: 20px; }\n    .footer { font-size: 0.9em; color: #888; margin-top: 20px; }\n  </style>\n</head>\n<body>\n  <h2>✅ Tasks Added to Notion</h2>\n\n  <div class=\"info\">\n <p>Meeting link: <a href=\"{{ $('Get row(s) in sheet').item.json.Link }}\">{{ $('Get row(s) in sheet').item.json.Link }}</a></p>\n    <p>All meeting tasks have been successfully added to Notion.</p>\n    <p>Check them here: <a href=\"https://www.notion.so/3275537cae1680e9a377e5b5b03b96ab?v=3275537cae1680ac8e06000cfe85cb32&source=copy_link\">Open Notion Database</a></p>\n  </div>\n\n  <div class=\"footer\">\n    This is an automated notification from your AI Meeting Agent.\n  </div>\n</body>\n</html>",
